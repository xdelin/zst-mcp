+    def _model_supports_vision(self) -> bool:
+        """当前模型是否支持视觉输入（带实例级缓存，避免逐条历史消息重复查询）。"""
+        if self._vision_supported is None:
+            try:
+                llm_model = cast(LargeLanguageModel, self.model_instance.model_type_instance)
+                model_schema = llm_model.get_model_schema(
+                    self.model_instance.model_name, self.model_instance.credentials
+                )
+                self._vision_supported = bool(
+                    model_schema and model_schema.features and ModelFeature.VISION in model_schema.features
+                )
+            except Exception:
+                # 查询失败时保持原行为（附带文件），避免误伤视觉模型
+                self._vision_supported = True
+        return self._vision_supported
 

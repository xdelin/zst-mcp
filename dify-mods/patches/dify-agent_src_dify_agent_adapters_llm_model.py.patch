     _pending: str = ""
     _inside_thinking: bool = False
+    # 复读熔断：模型退化时会在 <think> 里逐字复读同一句（事故见 2026-09-24 drawio 会话），
+    # 不拦截会把几十万字符垃圾灌进思考块并烧掉 token。delta 粒度因供应商而异，
+    # 故同时按「连续相同」与「累计相同」两个口径计数，任一超限即丢弃后续思考增量。
+    _last_think_delta: str = ""
+    _think_repeat_streak: int = 0
+    _think_repeat_totals: dict[str, int] = field(default_factory=dict)
+    _think_circuit_broken: bool = False

+# 复读熔断阈值：同一思考句连续出现 8 次、或累计出现 24 次，判为复读退化并截断后续思考。
+_THINK_REPEAT_STREAK_LIMIT = 8
+_THINK_REPEAT_TOTAL_LIMIT = 24
+# 句子切片：遇到句号/分号/换行切一段，无分隔符时整段为一片
+_THINK_SEGMENT_RE = re.compile(r".*?[。;；\n]|.+", re.S)
+# 无句读的长切片退化为一片，句子统计拦不住——额外对切片做尾部周期性检测
+# （切片末尾由同一短单元连续重复 >= 熔断阈值次即判复读）
+_THINK_PERIODIC_MIN_LEN = 64
+_THINK_PERIODIC_MAX_UNIT = 64
+
+# 结构化 thinking（端到端独立字段通路）：思考以 chunk delta.reasoning_content 下发，
+# 不再嵌入 <think> 标签文本。仅对声明支持原生 reasoning_content 的供应商注入开关参数，
+# 插件（tongyi）据此切换输出通路，其他调用方不受影响。
+_THINKING_OUTPUT_PARAMETER = "thinking_output"
+_THINKING_OUTPUT_STRUCTURED = "structured"
+_DEFAULT_STRUCTURED_THINKING_PROVIDERS = "langgenius/tongyi/tongyi"
+
+
+def _structured_thinking_providers() -> frozenset[str]:
+    raw = os.environ.get("DIFY_AGENT_STRUCTURED_THINKING_PROVIDERS", "").strip()
+    if not raw:
+        raw = _DEFAULT_STRUCTURED_THINKING_PROVIDERS
+    return frozenset(item.strip() for item in raw.split(",") if item.strip())
+
+
+def _periodic_repeat_count(text: str) -> int:
+    best = 1
+    limit = min(_THINK_PERIODIC_MAX_UNIT, len(text) // 2)
+    for unit_len in range(1, limit + 1):
+        unit = text[-unit_len:]
+        count = 1
+        pos = len(text) - unit_len
+        while pos >= unit_len and text[pos - unit_len : pos] == unit:
+            count += 1
+            pos -= unit_len
+        if count > best:
+            best = count
+    return best
+

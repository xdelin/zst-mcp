+    def _emit_thinking(
+        self,
+        parts_manager: ModelResponsePartsManager,
+        provider_name: str,
+        content: str,
+    ) -> list[ModelResponseStreamEvent]:
+        if self._think_circuit_broken or not content:
+            return []
+        events: list[ModelResponseStreamEvent] = []
+        # delta 粒度因供应商而异：退化复读可能整段塞在一个 delta 里到达，

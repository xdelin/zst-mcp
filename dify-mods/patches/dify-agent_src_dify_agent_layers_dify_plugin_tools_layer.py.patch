+    async def upload_tool_blob(
+        self,
+        *,
+        execution_context: DifyExecutionContextLayerConfig,
+        blob: bytes,
+        filename: str,
+        mimetype: str,
+    ) -> _UploadedToolFile | None:
+        """Upload raw tool-output bytes to Dify; return a frontend-reachable URL.
+
+        BLOB tool responses (思维导图 PNG 等插件产物) 不能字符串化进 observation：
+        多兆字节的 ``blob=b'...'`` repr 会灌爆 LLM 上下文（qwen 上限 ~98 万 token
+        输入直接 400）并污染前端思考块。这里走 Dify 的签名插件上传通道
+        （inner upload-request → for-plugin PUT）落成 tool_file，observation 只带 URL。
+        任何失败都返回 ``None``，由调用方降级为纯文字提示（绝不回退到字节 repr）。
+        """
+        if execution_context.user_id is None or execution_context.user_from is None:
+            logger.warning("tool blob upload skipped: execution context is missing user identity")
+            return None
+
+        payload = {
+            "tenant_id": execution_context.tenant_id,
+            "user_id": execution_context.user_id,
+            "user_from": execution_context.user_from,
+            "filename": filename,
+            "mimetype": mimetype,
+            "conversation_id": execution_context.conversation_id,
+            "max_size": _BLOB_UPLOAD_MAX_SIZE_BYTES,
+        }
+        try:
+            request_response = await self.http_client.post(
+                f"{self.base_url}/inner/api/agent/files/upload-request",
+                headers={"X-Inner-Api-Key": self.api_key, "Content-Type": "application/json"},
+                json=payload,
+            )
+            request_data = request_response.json() if request_response.content else None
+            if request_response.status_code >= 400 or not isinstance(request_data, dict):
+                logger.warning(
+                    "tool blob upload request rejected: HTTP %s", request_response.status_code
+                )
+                return None
+            upload_uri = request_data.get("upload_uri")
+            if not isinstance(upload_uri, str) or not upload_uri:
+                logger.warning("tool blob upload request response is missing upload_uri")
+                return None
+
+            upload_response = await self.http_client.post(
+                f"{self.base_url}{upload_uri}",
+                files={"file": (filename, blob, mimetype)},
+                follow_redirects=True,
+            )
+            upload_data = upload_response.json() if upload_response.content else None
+            if upload_response.status_code >= 400 or not isinstance(upload_data, dict):
+                logger.warning(
+                    "tool blob upload failed: HTTP %s", upload_response.status_code
+                )
+                return None
+            url = _relativize_file_url(upload_data.get("preview_url"))
+            if url is None:
+                logger.warning("tool blob upload response has no usable preview_url")
+                return None
+            uploaded_name = upload_data.get("name")
+            return _UploadedToolFile(
+                name=uploaded_name if isinstance(uploaded_name, str) and uploaded_name else filename,
+                url=url,
+            )
+        except Exception:
+            logger.warning("tool blob upload errored", exc_info=True)
+            return None
+
 

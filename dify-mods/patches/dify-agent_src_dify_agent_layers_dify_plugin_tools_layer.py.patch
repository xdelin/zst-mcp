+def _relativize_file_url(url: object) -> str | None:
+    """把绝对 http(s) 的 /files/... URL 转成相对路径；非文件 URL 返回 None。
+
+    前端对 /files/... 走同源代理（https 页面下绝对 http 源会被混合内容拦截）；
+    API 侧历史消息重签（re_sign_file_url_answer）同样支持相对形式。
+    """
+    if not isinstance(url, str) or not url:
+        return None
+    parsed = urlparse(url)
+    if parsed.scheme in {"http", "https"} and parsed.path.startswith("/files/"):
+        return f"{parsed.path}?{parsed.query}" if parsed.query else parsed.path
+    if url.startswith("/files/"):
+        return url
+    return None
+
+
+def _blob_message_parts(response: DifyPluginToolInvokeMessage) -> tuple[bytes, str, str] | None:
+    """Extract (blob, filename, mimetype) from a BLOB tool response, else None."""
+    if response.type is not DifyPluginToolInvokeMessage.MessageType.BLOB:
+        return None
+    message = response.message
+    if not isinstance(message, DifyPluginToolInvokeMessage.BlobMessage):
+        return None
+    meta = response.meta or {}
+    filename = meta.get("filename")
+    mimetype = meta.get("mime_type")
+    return (
+        message.blob,
+        filename if isinstance(filename, str) and filename else "file",
+        mimetype if isinstance(mimetype, str) and mimetype else "application/octet-stream",
+    )
+
+
+def _sniff_blob_mimetype(blob: bytes, declared: str) -> str:
+    """补齐/校正 BLOB 的 mimetype：插件 meta 缺失时按魔数识别常见图片格式。"""
+    if declared and declared != "application/octet-stream":
+        return declared
+    if blob.startswith(b"\x89PNG"):
+        return "image/png"
+    if blob.startswith(b"\xff\xd8\xff"):
+        return "image/jpeg"
+    if blob.startswith((b"GIF87a", b"GIF89a")):
+        return "image/gif"
+    return declared or "application/octet-stream"
+
+
+def _blob_fallback_filename(mimetype: str) -> str:
+    guessed = mimetypes.guess_extension(mimetype)
+    return f"file{guessed or '.bin'}"
+
+
+async def _materialize_blob_messages(
+    messages: Sequence[DifyPluginToolInvokeMessage],
+    *,
+    file_context: "_PluginToolFileContext",
+) -> list[DifyPluginToolInvokeMessage]:
+    """把 BLOB 工具返回替换成「已上传文件的 URL」文字 observation。
+
+    上传成功：observation 携带相对 URL，并提示模型在最终回答里用 markdown
+    图片语法展示（dify-agent 应用没有 message_files 通道，正文是唯一通道）。
+    上传失败：降级为固定文字（不带字节数据），模型只告知用户文件交付失败。
+    """
+    converted: list[DifyPluginToolInvokeMessage] = []
+    for response in messages:
+        parts = _blob_message_parts(response)
+        if parts is None:
+            converted.append(response)
+            continue
+
+        blob, filename, mimetype = parts
+        mimetype = _sniff_blob_mimetype(blob, mimetype)
+        if not filename or filename == "file":
+            filename = _blob_fallback_filename(mimetype)
+
+        uploaded: _UploadedToolFile | None = None
+        if len(blob) > _BLOB_UPLOAD_MAX_SIZE_BYTES:
+            logger.warning(
+                "tool blob of %d bytes exceeds upload cap; dropping delivery", len(blob)
+            )
+        else:
+            uploaded = await file_context.file_client.upload_tool_blob(
+                execution_context=file_context.execution_context,
+                blob=blob,
+                filename=filename,
+                mimetype=mimetype,
+            )
+
+        if uploaded is not None:
+            text = (
+                f"Generated file {uploaded.name} (uploaded and ready for the user): {uploaded.url}. "
+                f"Include this URL in your final reply so the user can view it "
+                f"(for images use markdown: ![{uploaded.name}]({uploaded.url})). "
+                "Do not generate the file again."
+            )
+        else:
+            text = (
+                "Generated file ... (delivery to the user failed). "
+                "Tell the user the file was produced but could not be delivered; do not retry generating it."
+            )
+        converted.append(
+            DifyPluginToolInvokeMessage(
+                type=DifyPluginToolInvokeMessage.MessageType.TEXT,
+                message=DifyPluginToolInvokeMessage.TextMessage(text=text),
+                meta=response.meta,
+            )
+        )
+    return converted
+
